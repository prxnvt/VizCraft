      "w": 360,
      "h": 260,
      "fill": "#fffafa",
      "line": "#c0392b",
      "keywords": [
        "trust",
        "boundary",
        "zone",
        "threat"
      ],
      "elementType": "dfd.TrustBoundary",
      "container": {
        "dash": "dashed",
        "heading": "plain",
        "corner": 6,
        "lineWidth": 1.5
      }
    },
    {
      "id": "dfd.gsProcess",
      "label": "Process (Gane-Sarson)",
      "category": "Gane-Sarson",
      "outline": "path",
      "w": 120,
      "h": 90,
      "fill": "#e4f2ec",
      "line": "#2d6e58",
      "keywords": [
        "bubble",
