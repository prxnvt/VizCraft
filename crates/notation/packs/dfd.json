{
  "schemaVersion": 1,
  "id": "dfd",
  "version": "1.0.0",
  "name": "Data Flow",
  "description": "Data flow diagrams: external entities, numbered processes and data stores joined by labelled flows, inside trust boundaries. Drawn in the Yourdon and DeMarco notation by default, or Gane and Sarson as a variant.",
  "audience": [
    "general",
    "software"
  ],
  "glyphs": [
    {
      "id": "dfd.entity",
      "label": "External Entity",
      "category": "Data Flow",
      "outline": "rectangle",
      "w": 120,
      "h": 60,
      "fill": "#eef1f4",
      "line": "#46535f",
      "keywords": [
        "source",
        "sink",
        "terminator",
        "actor"
      ],
      "elementType": "dfd.ExternalEntity"
    },
    {
      "id": "dfd.process",
      "label": "Process",
      "category": "Data Flow",
      "outline": "ellipse",
      "w": 110,
      "h": 110,
      "fill": "#e4f2ec",
      "line": "#2d6e58",
      "keywords": [
        "bubble",
        "transform",
        "function"
      ],
      "elementType": "dfd.Process"
    },
    {
      "id": "dfd.store",
      "label": "Data Store",
      "category": "Data Flow",
      "outline": "path",
      "w": 140,
      "h": 50,
      "fill": "#ffffff",
      "line": "#84523c",
      "keywords": [
        "file",
        "database",
        "store"
      ],
      "elementType": "dfd.DataStore",
