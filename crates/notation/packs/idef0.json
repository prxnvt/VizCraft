          }
        },
        {
          "command": "connector.add",
          "params": {
            "from": {
              "shape": "${b2.shape}",
              "point": 2
            },
            "to": {
              "shape": "${b3.shape}",
              "point": 0
            },
            "kind": "idef0.arrow",
            "relationship": "idef0.Arrow",
            "text": "Parts"
          }
        },
        {
          "command": "connector.add",
          "params": {
            "from": {
              "shape": "${dec.shapes.M1}"
            },
            "to": {
              "shape": "${b2.shape}",
              "point": 3
            },
            "kind": "idef0.arrow",
            "relationship": "idef0.Arrow",
