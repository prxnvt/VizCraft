        {
          "command": "connector.add",
          "params": {
            "from": {
              "shape": "${b1.shape}",
              "point": 2
            },
            "to": {
              "shape": "${b3.shape}",
              "point": 1
            },
            "kind": "idef0.arrow",
            "relationship": "idef0.Arrow",
            "text": "Inspection plan"
