        "engineering"
      ],
      "keywords": [
        "idef0",
        "decomposition"
      ],
      "viewpoint": "idef0.Context",
      "variant": "idef0.fips183",
      "sheet": "iso.a3.landscape",
      "titleBlock": true,
      "rulesets": [
        "idef0.fips183"
      ],
      "seed": [
        {
          "command": "element.create",
          "as": "box",
          "params": {
            "type": "idef0.Activity",
            "name": "Make widget",
            "x": 560,
            "y": 380,
            "properties": {
              "number": "0"
            }
          }
        },
        {
          "command": "element.create",
          "as": "bi",
          "params": {
            "type": "idef0.Boundary",
            "name": "",
            "x": 240,
            "y": 430
          }
        },
        {
          "command": "element.create",
          "as": "bc",
          "params": {
            "type": "idef0.Boundary",
            "name": "",
            "x": 656,
            "y": 230
          }
        },
        {
          "command": "element.create",
          "as": "bo",
          "params": {
            "type": "idef0.Boundary",
            "name": "",
            "x": 1000,
            "y": 430
          }
        },
        {
          "command": "element.create",
          "as": "bm",
          "params": {
            "type": "idef0.Boundary",
            "name": "",
            "x": 656,
            "y": 640
          }
        },
        {
          "command": "connector.add",
          "params": {
            "from": {
              "shape": "${bi.shape}"
            },
            "to": {
              "shape": "${box.shape}",
              "point": 0
