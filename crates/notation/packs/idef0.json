        },
        {
          "command": "connector.add",
          "params": {
            "from": {
              "shape": "${dec.shapes.I1}"
            },
            "to": {
              "shape": "${b2.shape}",
              "point": 0
            },
            "kind": "idef0.arrow",
            "relationship": "idef0.Arrow",
