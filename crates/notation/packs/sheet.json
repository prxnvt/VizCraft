  "connectorTypes": [
    {
      "id": "sheet.leader",
      "label": "Balloon leader",
      "category": "Sheet",
      "route": "straight",
      "startArrow": "none",
      "endArrow": "circle",
      "dash": "solid",
      "lineWidth": 1.0,
      "line": "#1e2630",
      "keywords": [
        "leader",
        "balloon",
        "find number",
        "item"
      ],
      "relationshipType": "sheet.CallsOut"
    }
  ],
  "elementTypes": [
    {
      "id": "sheet.Revision",
      "label": "Revision",
      "description": "One revision of the drawing: its letter, the zone it changed, what changed, when and who approved it. Revision tables list them.",
      "glyph": "sheet.revision",
      "properties": [
        {
          "key": "rev",
          "label": "Revision",
          "kind": "text"
        },
        {
          "key": "zone",
          "label": "Zone",
          "kind": "text"
        },
        {
          "key": "description",
          "label": "Description",
          "kind": "text"
        },
        {
          "key": "date",
          "label": "Date",
          "kind": "text"
        },
        {
          "key": "approved",
          "label": "Approved by",
          "kind": "text"
        }
      ]
    },
    {
      "id": "sheet.RevisionTable",
      "label": "Revision Table",
      "description": "A table of the drawing's revisions, filled from the Revision elements.",
      "glyph": "sheet.revisionTable",
      "compartments": [
        {
          "id": "rows",
          "kind": "list",
          "query": {
            "types": [
              "sheet.Revision"
            ],
            "columns": [
              "zone",
              "rev",
              "description",
              "date",
              "approved"
            ],
            "headers": [
              "ZONE",
              "REV",
              "DESCRIPTION",
              "DATE",
              "APPROVED"
            ],
            "widths": [
              50,
              40,
              190,
              70,
              70
            ],
            "sortBy": "rev"
          }
        }
      ]
    },
    {
      "id": "sheet.Part",
      "label": "Part",
      "description": "One item of an assembly; its tag is the item number.",
      "glyph": "sheet.part",
      "properties": [
        {
          "key": "quantity",
          "label": "Quantity",
          "kind": "integer",
          "default": 1
        },
        {
          "key": "partNumber",
          "label": "Part number",
          "kind": "text"
        },
        {
          "key": "description",
          "label": "Description",
          "kind": "text"
        },
        {
          "key": "material",
          "label": "Material",
          "kind": "text"
        }
      ]
    },
    {
      "id": "sheet.PartsList",
      "label": "Parts List",
      "description": "A table of the parts, filled from the Part elements and sorted by item number.",
      "glyph": "sheet.partsList",
      "properties": [
        {
          "key": "types",
          "label": "Listed types",
          "kind": "text",
          "default": "sheet.Part",
          "description": "Element types the list shows, separated by commas."
        }
      ],
      "compartments": [
        {
          "id": "rows",
          "kind": "list",
          "query": {
            "types": [
              "sheet.Part"
            ],
            "columns": [
              "tag",
              "quantity",
              "partNumber",
              "description",
              "material"
            ],
            "headers": [
              "ITEM",
              "QTY",
              "PART NUMBER",
              "DESCRIPTION",
              "MATERIAL"
            ],
            "widths": [
              40,
              40,
              100,
              160,
              80
            ],
            "sortBy": "tag"
          }
        }
      ]
    },
    {
      "id": "sheet.Balloon",
      "label": "Balloon",
      "description": "An item number in a circle, with a leader to the part it calls out. It shows the part's item number.",
      "glyph": "sheet.balloon"
    },
    {
      "id": "sheet.OffSheet",
      "label": "Off-sheet Reference",
      "description": "Where a line continues on another sheet; two references with the same tag are partners and each shows where the other is.",
      "glyph": "sheet.offSheet",
      "properties": [
        {
          "key": "xrefLabel",
          "label": "Location label",
          "kind": "enum",
          "values": [
            "on",
            "off"
          ],
          "default": "on"
        }
      ]
    }
  ],
  "relationshipTypes": [
    {
      "id": "sheet.CallsOut",
      "label": "Calls out",
      "description": "A balloon names the part its leader points at.",
      "endArrow": "none"
    },
    {
      "id": "sheet.Continues",
      "label": "Continues",
      "description": "A line continues from one off-sheet reference to its partner.",
      "endArrow": "none",
      "kind": "crossReference"
    },
    {
      "id": "sheet.References",
      "label": "References",
      "description": "A cross reference between any two elements (a contact and its coil): each end is labelled with the other's sheet and zone.",
      "endArrow": "none",
      "kind": "crossReference"
    }
  ],
  "connections": [
    {
      "source": [
        "sheet.Balloon"
      ],
      "relationship": "sheet.CallsOut",
      "target": [
        "sheet.Part"
      ],
      "outMax": 1
    },
    {
      "source": [
        "sheet.OffSheet"
      ],
      "relationship": "sheet.Continues",
      "target": [
        "sheet.OffSheet"
      ]
    },
    {
      "source": [
        "*"
      ],
      "relationship": "sheet.References",
      "target": [
        "*"
      ]
    }
  ],
  "palette": [
    {
      "id": "sheet.callouts",
      "label": "Callouts",
      "types": [
        "sheet.Balloon",
        "sheet.Part",
        "sheet.OffSheet"
      ]
    },
    {
      "id": "sheet.tables",
      "label": "Sheet tables",
      "types": [
        "sheet.RevisionTable",
        "sheet.Revision",
        "sheet.PartsList"
      ]
    }
  ],
  "viewpoints": [
    {
      "id": "sheet.Sheet",
      "label": "Drawing sheet",
      "description": "A drawing sheet: the frame and title block, revision table, parts list with balloons, and off-sheet and cross references.",
      "types": [
        "*"
      ],
      "relationships": [
        "sheet.CallsOut",
        "sheet.Continues",
        "sheet.References"
      ]
    }
  ],
  "identifiers": [
    {
      "id": "sheet.item",
      "types": [
        "sheet.Part"
      ],
      "format": "{n}",
      "unique": true,
      "autoNumber": true
    },
    {
      "id": "sheet.revision",
      "types": [
        "sheet.Revision"
      ],
      "format": "{rev}",
      "unique": true,
      "autoNumber": false
    },
    {
      "id": "sheet.offSheet",
      "types": [
        "sheet.OffSheet"
      ],
      "format": "{n}",
      "unique": false,
      "paired": true,
      "autoNumber": false
    }
  ],
  "rules": [
    {
      "id": "sheet.mandatoryFields",
      "description": "The title block's mandatory fields are filled in.",
      "severity": "warning",
      "mode": "live",
      "reference": "ISO 7200:2004, data fields in title blocks: mandatory fields",
      "check": {
        "kind": "documentFields"
      }
    },
    {
      "id": "sheet.fieldLength",
      "description": "Title block fields fit their cells.",
      "severity": "warning",
      "mode": "live",
      "reference": "ISO 7200:2004, data fields in title blocks: recommended number of characters",
      "check": {
        "kind": "documentFields",
        "length": true
      }
    },
    {
      "id": "sheet.revisionSequence",
      "description": "Revisions follow each other in the revision scheme's order, without gaps or repeats.",
      "severity": "warning",
      "mode": "live",
      "reference": "ASME Y14.35, revision identifiers; ISO 7200 revision index",
      "check": {
        "kind": "revisionSequence"
      }
    },
    {
      "id": "sheet.balloonRows",
      "description": "Each balloon calls out one listed part, and each part has a balloon.",
      "severity": "warning",
      "mode": "live",
      "reference": "ASME Y14.34, parts lists and find numbers; ISO 6433, item references",
      "check": {
        "kind": "balloonRows"
      }
    },
    {
      "id": "sheet.unresolvedXref",
      "description": "A cross reference points at an element drawn somewhere.",
      "severity": "warning",
      "mode": "live",
      "reference": "VizCraft house rule: a cross reference can be followed",
      "check": {
        "kind": "crossReferences"
      }
    },
    {
      "id": "sheet.unmatchedOffSheet",
      "description": "An off-sheet reference has a partner with the same tag.",
      "severity": "warning",
      "mode": "live",
      "reference": "VizCraft house rule: a continued line continues somewhere",
      "check": {
        "kind": "unmatchedPair",
        "scope": "sheet.offSheet"
      }
    },
    {
      "id": "sheet.duplicateItem",
      "description": "Item numbers are unique.",
      "severity": "error",
      "mode": "live",
      "reference": "ASME Y14.34, find numbers",
      "check": {
        "kind": "duplicateIdentifier",
        "scope": "sheet.item"
      }
    },
    {
      "id": "sheet.staleTag",
      "description": "A tag composed from its sheet, zone or rung still matches where the element is; run sheet.renumber to update it.",
      "severity": "info",
      "mode": "live",
      "reference": "VizCraft house rule: composed tags are updated on request",
      "check": {
        "kind": "staleTag"
      }
    }
  ],
  "rulesets": [
    {
      "id": "sheet.drawingSheet",
      "label": "Drawing sheet (ISO 7200, ASME Y14)",
      "description": "Title block fields filled in and within their lengths, revisions in sequence, one balloon per listed part, cross and off-sheet references that resolve, unique item numbers and current composed tags.",
      "rules": [
        "sheet.mandatoryFields",
        "sheet.fieldLength",
        "sheet.revisionSequence",
        "sheet.balloonRows",
        "sheet.unresolvedXref",
        "sheet.unmatchedOffSheet",
        "sheet.duplicateItem",
        "sheet.staleTag"
      ]
    }
  ],
