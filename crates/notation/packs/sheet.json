{
  "schemaVersion": 1,
  "id": "sheet",
  "version": "1.0.0",
  "name": "Drawing Sheet",
  "description": "Drawing sheets: ISO 5457 and ASME Y14.1 frames with zones, the ISO 7200 title block fields as document properties, revision tables, parts lists with balloons, off-sheet references and cross references. ISO is the default; ASME is always offered.",
  "audience": [
    "industrial",
    "engineering"
  ],
  "glyphs": [
