  "rules": [
    {
      "id": "er.illegal",
      "description": "An identifying relationship must end at a weak entity, and relationships join entities.",
      "severity": "error",
      "mode": "live",
      "check": {
        "kind": "illegalRelationship"
      },
      "reference": "Chen 1976, 2.3 weak entity relations; IDEF1X (FIPS 184), 3.3.2 identifying relationships"
    },
    {
      "id": "er.cardinality",
      "description": "Every relationship needs a cardinality at both ends.",
      "severity": "error",
      "mode": "live",
      "check": {
        "kind": "requiredProperty",
        "types": []
      }
    },
    {
      "id": "er.weakEntityIdentified",
      "description": "A weak entity needs an identifying relationship from its parent.",
      "severity": "error",
      "mode": "live",
      "check": {
        "kind": "minIncoming",
        "types": [
          "er.WeakEntity"
        ],
        "relationship": "er.Identifying",
        "min": 1
      },
      "reference": "Chen 1976, 2.3; IDEF1X (FIPS 184), 3.2.2 identifier-dependent entities"
    },
    {
      "id": "er.primaryKey",
      "description": "A table needs a primary key.",
      "severity": "warning",
      "mode": "live",
      "check": {
        "kind": "primaryKey",
        "types": [
          "er.Entity"
        ],
        "viewpoints": [
          "er.Physical"
        ]
      }
    },
    {
      "id": "er.foreignKey",
      "description": "A foreign key must reference an existing column of the same type.",
      "severity": "error",
      "mode": "live",
      "check": {
        "kind": "foreignKey",
        "types": [
          "er.Attribute"
        ]
      }
    },
    {
      "id": "er.propertyType",
      "description": "ER property values must fit their types.",
      "severity": "error",
      "mode": "live",
      "check": {
        "kind": "propertyType",
        "types": []
      }
    },
    {
      "id": "er.viewpoint",
      "description": "This kind of ER element does not belong on this kind of diagram.",
      "severity": "warning",
      "mode": "live",
      "check": {
        "kind": "viewpointType"
      }
    },
    {
      "id": "er.dangling",
      "description": "Every ER relationship line should join two entities.",
      "severity": "warning",
      "mode": "live",
      "check": {
        "kind": "danglingConnector"
      }
    }
  ],
