  "elementTypes": [
    {
      "id": "er.Entity",
      "label": "Entity",
      "description": "A thing the data describes, drawn as a table: its columns are the attributes it owns.",
      "glyph": "er.entity",
      "container": true,
      "properties": [
        {
          "key": "schema",
          "label": "Schema",
          "kind": "text",
          "description": "The database schema the table is in; empty for the default."
        },
        {
          "key": "alias",
          "label": "Alias",
          "kind": "text",
          "description": "A short name other definitions may use for the table."
        },
        {
          "key": "note",
          "label": "Note",
          "kind": "text",
          "description": "A note on the table."
        },
        {
          "key": "indexes",
          "label": "Indexes",
          "kind": "text",
          "description": "Index definitions, one per line, as DBML writes them inside indexes { }."
        },
        {
          "key": "group",
          "label": "Group",
          "kind": "text",
          "description": "The table group it belongs to."
        }
      ],
      "compartments": [
        {
          "id": "keys",
          "kind": "list",
          "query": {
            "types": [
              "er.Attribute"
            ],
            "owned": true,
            "filter": {
              "property": "pk",
              "equals": true
            },
            "columns": [
              "pk",
              "name",
              "dataType"
            ],
            "headers": [
              "Key",
              "Column",
              "Type"
            ],
            "widths": [
              40,
              110,
              90
            ],
            "values": {
              "pk": {
                "true": "PK"
              }
            }
          }
        },
        {
          "id": "attrs",
          "kind": "list",
          "query": {
            "types": [
              "er.Attribute"
            ],
            "owned": true,
            "filter": {
              "property": "pk",
              "equals": false
            },
            "columns": [
              "fk",
              "name",
              "dataType"
            ],
            "headers": [
              "",
              "Column",
              "Type"
            ],
            "widths": [
              40,
              110,
              90
            ],
            "values": {
              "fk": {
                "true": "FK"
              }
            }
          }
        }
      ]
    },
