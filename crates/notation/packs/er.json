  "relationshipTypes": [
    {
      "id": "er.Relationship",
      "label": "Relationship",
      "description": "A non-identifying relationship from the parent (the referenced entity) to the child (the one holding the foreign key).",
      "endArrow": "none",
      "properties": [
        {
          "key": "sourceCardinality",
          "label": "Parent cardinality",
          "kind": "enum",
          "values": [
            "one",
            "zeroOrOne",
            "oneOrMore",
            "zeroOrMore"
          ],
          "required": true,
          "description": "How many entities at this end: one, zero or one, one or more, zero or more."
        },
        {
          "key": "targetCardinality",
          "label": "Child cardinality",
          "kind": "enum",
          "values": [
            "one",
            "zeroOrOne",
            "oneOrMore",
            "zeroOrMore"
          ],
          "required": true,
          "description": "How many entities at this end: one, zero or one, one or more, zero or more."
        },
        {
          "key": "onDelete",
          "label": "On delete",
          "kind": "enum",
          "values": [
            "noAction",
            "restrict",
            "cascade",
            "setNull",
            "setDefault"
          ],
          "description": "What deleting the parent row does to the child rows."
        },
        {
          "key": "onUpdate",
          "label": "On update",
          "kind": "enum",
          "values": [
            "noAction",
            "restrict",
            "cascade",
            "setNull",
            "setDefault"
          ],
          "description": "What changing the parent key does to the child rows."
        }
      ]
    },
    {
      "id": "er.Identifying",
      "label": "Identifying Relationship",
      "description": "A relationship whose foreign key is part of the child's primary key: the child is identified through the parent.",
      "endArrow": "none",
      "properties": [
        {
          "key": "sourceCardinality",
          "label": "Parent cardinality",
          "kind": "enum",
          "values": [
            "one",
            "zeroOrOne",
            "oneOrMore",
