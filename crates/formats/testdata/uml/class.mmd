classDiagram
  %% A small library model, written by hand for the UML round trip.
  class Item {
    <<abstract>>
    +String title
    #Integer copies
    +isAvailable() Boolean
  }
  class Book {
    +String isbn
    +List~String~ authors
  }
  class Loan {
    +Date due
    +renew(days: Integer) Date
    +count()$ Integer
  }
  class Lendable {
    <<interface>>
    +lend(member: Member) Loan
  }
  class Status {
    <<enumeration>>
    ACTIVE
    OVERDUE
    RETURNED
  }
  namespace people {
    class Member {
      +String name
      -String[0..1] email
    }
  }
  Item <|-- Book
  Book ..|> Lendable
  Member "1" --> "0..*" Loan : borrows
  Loan "0..*" -- "1" Item
  Item *-- Status
  Loan ..> Status
