[Desktop Entry]
Type=Application
Name=VizCraft
GenericName=Diagram Editor
Comment=Draw flowcharts, org charts and system diagrams
Exec=vizcraft %F
TryExec=vizcraft
Icon=io.github.prxnvt.vizcraft
Terminal=false
StartupNotify=true
StartupWMClass=io.github.prxnvt.vizcraft
Categories=Office;Graphics;
Keywords=diagram;flowchart;vizcraft;
MimeType=application/x-vizcraft+json;application/json;
