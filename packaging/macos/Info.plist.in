<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@ (the git commit the app was built from).
     The crafts/rebuild.sh installer reads CFBundleName from this file to find the installed app
     and <CFBundleName>BuildCommit from the installed Info.plist to decide whether to rebuild, so
     keep both keys and keep the prefix of the BuildCommit key equal to CFBundleName. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>VizCraft</string>
  <key>CFBundleName</key>
  <string>VizCraft</string>
  <key>CFBundleExecutable</key>
  <string>VizCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.vizcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>VizCraftVersion</key>
  <string>@VERSION@</string>
  <key>VizCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>VizCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (c) 2026 VizCraft contributors. MIT OR Apache-2.0.</string>

  <!-- Documents the app opens from Finder (double click, Open With, Dock drops). Today the
       placeholder model saves `.craft.json`; Cascade 1 replaces it with `.vizcraft` (declared
       under UTExportedTypeDeclarations) and adds `.drawio` as an alternate type. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>VizCraft Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>craft.json</string>
      </array>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.vizcraft.document</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.vizcraft.document</string>
      <key>UTTypeDescription</key>
      <string>VizCraft Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>craft.json</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
